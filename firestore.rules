rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // البريد المؤكد شرط لكل شيء: يمنع من يسجّل بريد زميل قبل صاحبه من الحصول على صلاحيته
    function signedIn() { return request.auth != null && request.auth.token.email != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email; }
    function rolePath() { return /databases/$(database)/documents/roles/$(me()); }
    function hasRole() { return signedIn() && exists(rolePath()); }
    function role() { return get(rolePath()).data.role; }
    // التحقق بخطوتين دون خطة مدفوعة: إن فعّل مدير النظام config/security.adminGoogle فلا تعمل صلاحية المدير
    // إلا لمن دخل في هذه الجلسة بحساب Google (الذي يحمل التحقق بخطوتين من Google). الدخول بكلمة المرور يبقى للأدوار الأخرى.
    function secPath() { return /databases/$(database)/documents/config/security; }
    function strongAdmin() { return !exists(secPath()) || get(secPath()).data.get('adminGoogle', false) != true
      || request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function isAdmin() { return hasRole() && role() == 'admin' && strongAdmin(); }
    function canWrite() { return hasRole() && (role() == 'editor' || isAdmin()); }
    // الإدارة التي ينتمي إليها المستخدم (يحددها مدير النظام من صفحة الاجتماعات أو التخويلات)
    function myUnit() { return get(rolePath()).data.get('unit', ''); }
    function top() { return isAdmin() || (hasRole() && myUnit() in ['gm', 'board']); }
    function mine(u) { return hasRole() && myUnit() != '' && myUnit() == u; }
    function str(d, k, max) { return d.get(k, '') is string && d.get(k, '').size() <= max; }

    // الصلاحيات: يقرأ كل مستخدم صلاحيته، ويديرها مدير النظام دون أن يتمكن من إزالة نفسه أو تخفيض صلاحيته (حماية من إقفال النظام)
    match /roles/{email} {
      function validRole() { return request.resource.data.role in ['admin', 'editor', 'viewer']
        && request.resource.data.keys().hasOnly(['role', 'name', 'unit'])
        && str(request.resource.data, 'name', 120) && str(request.resource.data, 'unit', 40); }
      function notSelf() { return email != me(); }
      allow read: if signedIn() && (email == me() || isAdmin());
      allow create: if isAdmin() && validRole();
      allow update: if isAdmin() && validRole() && (notSelf() || request.resource.data.role == 'admin');
      allow delete: if isAdmin() && notSelf();
    }
    // سجل النشاط: يُضاف إليه فقط، باسم الكاتب نفسه، ولا يُعدَّل ولا يُحذف
    match /log/{id} {
      allow read: if isAdmin();
      // at: وقت الخادم (لا يمكن تزويره)، ts: وقت الجهاز للعرض
      allow create: if canWrite() && request.resource.data.user == me() && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['at', 'ts', 'user', 'name', 'action', 'col', 'id', 'summary'])
        && str(request.resource.data, 'summary', 500) && str(request.resource.data, 'action', 60);
    }
    // الاجتماعات المغلقة: لا يراها إلا مدير النظام ومنشئ الاجتماع والإدارات المدعوة
    match /meetings/{id} {
      function owner() { return signedIn() && resource.data.createdBy == me(); }
      function invited() { return hasRole() && myUnit() != '' && myUnit() in resource.data.units; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function sameCore() { return request.resource.data.units == resource.data.units
        && request.resource.data.organizer == resource.data.organizer
        && request.resource.data.createdBy == resource.data.createdBy; }
      function validMeeting() { return str(request.resource.data, 'title', 300) && request.resource.data.units.size() <= 60
        && (!('decisions' in request.resource.data) || request.resource.data.decisions.size() <= 200); }
      allow read: if isAdmin() || owner() || invited();
      allow create: if canWrite()
        && request.resource.data.createdBy == me()
        && request.resource.data.units is list
        && request.resource.data.organizer in request.resource.data.units
        && validMeeting()
        && (isAdmin() || myUnit() == request.resource.data.organizer);
      allow update: if validMeeting() && (isAdmin() || owner()
        || (canWrite() && invited() && myUnit() == resource.data.organizer && sameCore())
        || (invited() && changed().hasOnly(['rsvp', 'updatedAt']))
        || (canWrite() && invited() && resource.data.status != 'closed' && resource.data.status != 'cancelled'
            && changed().hasOnly(['minutes', 'decisions', 'attachments', 'updatedAt']))
        || (canWrite() && invited() && changed().hasOnly(['decisions', 'updatedAt'])));
      allow delete: if isAdmin() || owner();
    }
    // سجلات الإدارات: تراها الإدارة نفسها والإدارة العامة والمجلس ومدير النظام، ويكتب فيها مدير النظام أو محرر من الإدارة نفسها أو من الإدارة العامة
    match /records/{id} {
      function unitOk(u) { return isAdmin() || (canWrite() && (myUnit() == u || myUnit() == 'gm')); }
      function validRec() { return str(request.resource.data, 'title', 300) && request.resource.data.title.size() > 0
        && str(request.resource.data, 'notes', 5000) && str(request.resource.data, 'ref', 200)
        && (!('attachments' in request.resource.data) || request.resource.data.attachments.size() <= 30); }
      // الحجز القانوني: يضعه ويرفعه مدير النظام فقط، وما دام قائمًا لا يُحذف السجل حتى بيد مدير النظام
      function holdSame() { return ('hold' in request.resource.data) == ('hold' in resource.data)
        && (!('hold' in resource.data) || request.resource.data.hold == resource.data.hold); }
      // تاريخ التعديلات: قائمة تُضاف إليها فقط (حتى 100 بند)
      function histOk() { return !('history' in request.resource.data) || (request.resource.data.history is list
        && request.resource.data.history.size() <= 100
        && request.resource.data.history.size() >= resource.data.get('history', []).size()
        && request.resource.data.history[0:resource.data.get('history', []).size()] == resource.data.get('history', [])); }
      allow read: if top() || mine(resource.data.unit);
      allow create: if unitOk(request.resource.data.unit) && request.resource.data.createdBy == me() && validRec()
        && !('hold' in request.resource.data) && !('history' in request.resource.data);
      allow update: if unitOk(resource.data.unit) && request.resource.data.unit == resource.data.unit
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '') && validRec()
        && (holdSame() || isAdmin()) && histOk();
      allow delete: if unitOk(resource.data.unit) && !('hold' in resource.data);
    }
    // المرفقات: files/<id> بيانات الملف و files/<id>_<n> أجزاء محتواه.
    // يرث الملف صلاحية السجل الذي يتبعه عبر scope في بيانات الملف:
    //   {k:'all'}            سجلات يقرؤها كل من له دور (العقود، الكشوفات، المراسلات، الطلبات...)
    //   {k:'units', u:[...]} سجلات الإدارات والتكليفات: الإدارات المذكورة ومدير النظام فقط
    //   {k:'meeting', id}    الاجتماعات المغلقة: من يرى الاجتماع نفسه الآن (المنشئ والمدعوون ومدير النظام)
    // رافع الملف يراه دائمًا. الملفات القديمة بلا scope تبقى كما كانت حتى يختمها مدير النظام (تحدث تلقائيًا عند دخوله).
    match /files/{id} {
      function isChunk() { return id.matches('^[^_]+_[0-9]+$'); }
      function metaOf() { return get(/databases/$(database)/documents/files/$(id.split('_')[0])).data; }
      function meetingOk(mid) { return isAdmin()
        || get(/databases/$(database)/documents/meetings/$(mid)).data.get('createdBy', '') == me()
        || (myUnit() != '' && myUnit() in get(/databases/$(database)/documents/meetings/$(mid)).data.get('units', [])); }
      function canSee(m) { return hasRole() && (m.get('byEmail', '') == me()
        || !('scope' in m)
        || m.scope.k == 'all'
        || (m.scope.k == 'units' && (isAdmin() || (myUnit() != '' && myUnit() in m.scope.u)))
        || (m.scope.k == 'meeting' && meetingOk(m.scope.id))); }
      function validScope(d) { return 'scope' in d && d.scope is map && d.scope.keys().hasOnly(['k', 'u', 'id'])
        && ((d.scope.k == 'all')
          || (d.scope.k == 'units' && d.scope.u is list && d.scope.u.size() <= 60)
          || (d.scope.k == 'meeting' && d.scope.id is string && d.scope.id.size() > 0 && d.scope.id.size() <= 100)); }
      function parentOwner() { return metaOf().get('byEmail', '') == me(); }
      allow get: if isChunk() ? canSee(metaOf()) : canSee(resource.data);
      allow list: if isAdmin();
      // بيانات الملف أولًا (باسم الرافع ومع scope)، ثم أجزاؤه بيد الرافع نفسه
      allow create: if canWrite() && (isChunk()
        ? (parentOwner() && request.resource.data.keys().hasOnly(['d']) && request.resource.data.d is string && request.resource.data.d.size() <= 800000)
        : (request.resource.data.get('byEmail', '') == me() && validScope(request.resource.data)));
      // ختم الصلاحية فقط: مدير النظام (ترحيل الملفات القديمة) أو الرافع
      allow update: if !isChunk() && (isAdmin() || (canWrite() && resource.data.get('byEmail', '') == me()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scope']) && validScope(request.resource.data);
      allow delete: if isAdmin() || (canWrite() && (isChunk() ? parentOwner() : resource.data.get('byEmail', '') == me()));
    }
    // مخرجات منظومة SMS055 (إدارة الشؤون التجارية والتحصيلات): ملف مستورد (batch) وأجزاء صفوفه (part) بصيغة JSON مضغوطة.
    // تقرؤها الإدارة نفسها والإدارة العامة والمجلس ومدير النظام، ويستوردها ويحذفها مدير النظام أو محرر من الإدارة أو من الإدارة العامة. لا تُعدَّل بعد الحفظ.
    match /sms055/{id} {
      function smsWriter() { return isAdmin() || (canWrite() && myUnit() in ['ca', 'gm']); }
      function validBatch() { return request.resource.data.kind == 'batch'
        && request.resource.data.keys().hasOnly(['kind', 'file', 'sheet', 'from', 'to', 'rows', 'parts', 'value', 'returns', 'createdBy', 'by', 'at'])
        && request.resource.data.createdBy == me() && str(request.resource.data, 'file', 200) && str(request.resource.data, 'sheet', 100)
        && str(request.resource.data, 'from', 10) && str(request.resource.data, 'to', 10) && str(request.resource.data, 'by', 120)
        && request.resource.data.rows is int && request.resource.data.parts is int && request.resource.data.parts <= 200
        && request.resource.data.value is number && request.resource.data.returns is number && str(request.resource.data, 'at', 40); }
      function validPart() { return request.resource.data.kind == 'part'
        && request.resource.data.keys().hasOnly(['kind', 'batch', 'n', 'd', 'createdBy'])
        && request.resource.data.createdBy == me() && request.resource.data.n is int
        && request.resource.data.d is string && request.resource.data.d.size() <= 900000 && id == request.resource.data.batch + '_p' + string(request.resource.data.n); }
      allow read: if top() || mine('ca');
      allow create: if smsWriter() && (validBatch() || validPart());
      allow delete: if smsWriter();
    }
    // لوحات مركز تقارير الإقفال الأخرى (تحليل المبيعات sales_report، حركة التحويلات transfers_report، أذونات الاستلام receipts_report) ولوحة الديون debts_report:
    // الشكل نفسه والصلاحيات نفسها كـ sms055 — ملف مستورد (batch) وأجزاء صفوفه (part)، لا تُعدَّل بعد الحفظ.
    match /{col}/{id} {
      function isClosures() { return col in ['sales_report', 'transfers_report', 'receipts_report', 'debts_report']; }
      function clxWriter() { return isAdmin() || (canWrite() && myUnit() in ['ca', 'gm']); }
      function validClxBatch() { return request.resource.data.kind == 'batch'
        && request.resource.data.keys().hasOnly(['kind', 'file', 'sheet', 'from', 'to', 'rows', 'parts', 'value', 'returns', 'createdBy', 'by', 'at'])
        && request.resource.data.createdBy == me() && str(request.resource.data, 'file', 200) && str(request.resource.data, 'sheet', 100)
        && str(request.resource.data, 'from', 10) && str(request.resource.data, 'to', 10) && str(request.resource.data, 'by', 120)
        && request.resource.data.rows is int && request.resource.data.parts is int && request.resource.data.parts <= 200
        && request.resource.data.value is number && request.resource.data.returns is number && str(request.resource.data, 'at', 40); }
      function validClxPart() { return request.resource.data.kind == 'part'
        && request.resource.data.keys().hasOnly(['kind', 'batch', 'n', 'd', 'createdBy'])
        && request.resource.data.createdBy == me() && request.resource.data.n is int
        && request.resource.data.d is string && request.resource.data.d.size() <= 900000 && id == request.resource.data.batch + '_p' + string(request.resource.data.n); }
      allow read: if isClosures() && (top() || mine('ca'));
      allow create: if isClosures() && clxWriter() && (validClxBatch() || validClxPart());
      allow delete: if isClosures() && clxWriter();
    }
    // هامش الربح (إدارة الشؤون التجارية والتحصيلات): وثيقة واحدة margin/prices بأسعار المنتجات وتكاليفها (بتاريخ سريان)
    // وسعر الصرف والهامش المستهدف وقائمة الزبائن الأجانب. بيانات مالية: تقرؤها الإدارة والإدارة العامة والمجلس والمدير،
    // ويعدّلها المدير أو محرر من الإدارة أو الإدارة العامة باسمه، ولا يحذفها إلا المدير.
    match /margin/{id} {
      function marginWriter() { return isAdmin() || (canWrite() && myUnit() in ['ca', 'gm']); }
      function validMargin() { return id == 'prices'
        && request.resource.data.keys().hasOnly(['products', 'rates', 'cur', 'target', 'min', 'foreign', 'updatedBy', 'by', 'at'])
        && request.resource.data.updatedBy == me()
        && request.resource.data.products is list && request.resource.data.products.size() <= 400
        && request.resource.data.rates is list && request.resource.data.rates.size() <= 400
        && request.resource.data.foreign is list && request.resource.data.foreign.size() <= 5000
        && str(request.resource.data, 'cur', 8) && str(request.resource.data, 'by', 120) && str(request.resource.data, 'at', 40)
        && request.resource.data.target is number && request.resource.data.target >= 0 && request.resource.data.target < 100
        && request.resource.data.min is number && request.resource.data.min >= 0 && request.resource.data.min < 100; }
      allow read: if top() || mine('ca');
      allow create, update: if marginWriter() && validMargin();
      allow delete: if isAdmin();
    }
    // مهام الإدارات المضافة من داخل المنظومة: يقرؤها الجميع ويكتبها مدير النظام فقط
    match /duties/{unit} {
      allow read: if hasRole();
      allow write: if isAdmin() && request.resource.data.items is list && request.resource.data.items.size() <= 200;
    }
    // التكليفات: لا يراها إلا مدير النظام والإدارة العامة وعضو المجلس والإدارة المُصدِرة والإدارة المكلَّفة
    match /assignments/{id} {
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function logAppended() { return request.resource.data.log is list
        && request.resource.data.log.size() == resource.data.log.size() + 1
        && request.resource.data.log[0:resource.data.log.size()] == resource.data.log; }
      function validA() { return str(request.resource.data, 'title', 300) && request.resource.data.title.size() > 0
        && str(request.resource.data, 'details', 4000) && str(request.resource.data, 'assignee', 120)
        && request.resource.data.get('priority', 'normal') in ['low', 'normal', 'high']
        && request.resource.data.get('progress', 0) is number
        && request.resource.data.get('progress', 0) >= 0 && request.resource.data.get('progress', 0) <= 100
        && request.resource.data.log is list && request.resource.data.log.size() <= 300
        && (!('attachments' in request.resource.data) || request.resource.data.attachments.size() <= 30); }
      function issuer() { return canWrite() && (isAdmin() || myUnit() == 'gm' || mine(resource.data.fromUnit)); }
      function doer() { return canWrite() && mine(resource.data.toUnit); }
      allow read: if top() || mine(resource.data.fromUnit) || mine(resource.data.toUnit);
      allow create: if canWrite()
        && request.resource.data.createdBy == me()
        && request.resource.data.status == 'new'
        && request.resource.data.log.size() == 1
        && validA()
        && (isAdmin() || (myUnit() == request.resource.data.fromUnit
            && (myUnit() == 'gm' || request.resource.data.toUnit == myUnit())));
      // الجهة المُصدِرة: تعدّل وتعتمد وتعيد، دون تغيير الجهتين أو المنشئ
      allow update: if validA() && ((issuer()
          && request.resource.data.fromUnit == resource.data.fromUnit
          && request.resource.data.toUnit == resource.data.toUnit
          && request.resource.data.createdBy == resource.data.createdBy
          && logAppended())
        // الإدارة المكلَّفة: تنفّذ وتحدّث الإنجاز وترفع للاعتماد، ولا تعتمد عملها بنفسها
        || (doer()
          && changed().hasOnly(['status', 'progress', 'log', 'updatedAt'])
          && request.resource.data.status in ['progress', 'review', 'hold']
          && logAppended()));
      allow delete: if isAdmin() || (canWrite() && resource.data.createdBy == me() && resource.data.status == 'new');
    }
    // تفضيلات المستخدم (الإشعارات والمقروء والعروض المحفوظة): يقرؤها ويكتبها صاحبها فقط
    match /prefs/{email} {
      allow read, write: if hasRole() && email == me();
    }
    // بلاغات الأخطاء من المتصفح: يضيفها كل من له دور باسمه، ويقرؤها ويحذفها مدير النظام
    match /clientErrors/{id} {
      allow read, delete: if isAdmin();
      allow create: if hasRole() && request.resource.data.user == me()
        && request.resource.data.keys().hasOnly(['ts', 'ref', 'msg', 'stack', 'screen', 'ver', 'ua', 'online', 'role', 'lang', 'user', 'note'])
        && str(request.resource.data, 'msg', 500) && str(request.resource.data, 'stack', 2000) && str(request.resource.data, 'note', 1000);
    }
    // الإعدادات: يغيّرها مدير النظام، عدا آلية إشعارات البيع التي يحررها المحررون
    match /config/{doc} {
      allow read: if hasRole();
      allow write: if !(doc in ['orgPeople', 'security']) && (isAdmin() || (canWrite() && doc == 'notices'));
    }
    // أسماء المسؤولين وأرقامهم الوظيفية في الهيكل: خارج كود الموقع العام، يقرؤها من له دور ويستوردها مدير النظام
    // فرض دخول المديرين بحساب Google: لا يُفعَّل إلا من جلسة Google (حتى لا يُقفل المدير نفسه خارج النظام)
    match /config/security {
      allow write: if isAdmin() && request.resource != null
        && request.resource.data.keys().hasOnly(['adminGoogle', 'by', 'at'])
        && request.resource.data.adminGoogle is bool && request.resource.data.by == me() && str(request.resource.data, 'at', 40)
        && (request.resource.data.adminGoogle == false || request.auth.token.firebase.sign_in_provider == 'google.com');
    }
    match /config/orgPeople {
      function okPeople(d) { return d.keys().hasOnly(['v', 'people', 'holder', 'updatedAt', 'by'])
        && d.people is map && d.people.size() <= 400
        && d.get('holder', {}) is map && d.get('holder', {}).size() <= 50
        && d.by == me() && str(d, 'updatedAt', 40); }
      allow write: if isAdmin() && request.resource != null && okPeople(request.resource.data);
      allow delete: if isAdmin();
    }
    // السجلات المشتركة: كل كتابة تُحفظ في الدفعة نفسها مع قيد جديد في سجل النشاط باسم الكاتب، وإلا رُفضت.
    // _log في الوثيقة رقم القيد. القيد يخص الوثيقة نفسها، أو يكون استيرادًا جماعيًا (id = '*') للمجموعة نفسها.
    match /{col}/{id} {
      function shared() { return col in ['contracts','needs','batches','extensions','letters','companies','tickets','notices']; }
      function logPath(l) { return /databases/$(database)/documents/log/$(l); }
      function logOk(l, bulk) { return l is string && l.size() > 0 && l.size() <= 200
        && !exists(logPath(l)) && existsAfter(logPath(l))
        && getAfter(logPath(l)).data.user == me() && getAfter(logPath(l)).data.col == col
        && (getAfter(logPath(l)).data.id == id || (bulk && getAfter(logPath(l)).data.id == '*')); }
      allow read: if hasRole() && shared();
      allow create: if canWrite() && shared() && logOk(request.resource.data.get('_log', ''), true);
      allow update: if canWrite() && shared() && logOk(request.resource.data.get('_log', ''), false);
      allow delete: if canWrite() && shared() && logOk('del-' + col + '-' + id + '-' + resource.data.get('_log', 'x'), false);
    }
  }
}
